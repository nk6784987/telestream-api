# ══════════════════════════════════════════════════════════
#   TeleStream API v2 — Environment Variables
#   Railway Dashboard > Apne project > Variables tab mein
#   yeh sab ek ek karke add karo
# ══════════════════════════════════════════════════════════

# 1. Telegram Bot Token
#    Kaise milega: Telegram pe @BotFather ko message karo
#    /newbot likhо → naam do → token copy karo
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. TMDB API Key (FREE hai)
#    Kaise milega:
#    → themoviedb.org pe account banao (free)
#    → Login karo → top-right avatar → Settings
#    → API → "Request an API Key" → Developer
#    → Form bharo (website: put anything) → API Key (v3) copy karo
TMDB_API_KEY=abcdef1234567890abcdef1234567890

# 3. Tera apna Telegram User ID
#    Kaise milega: Telegram pe @userinfobot ko /start bhejo
#    Jo number aaye woh yahan dalo (sirf numbers, koi @ nahi)
ADMIN_USER_ID=123456789

# 4. Railway deploy ke baad milne wala URL
#    Deploy karo → Railway dashboard mein "Deployments" tab
#    → URL wahan hoga (copy karo, https:// ke saath)
BASE_URL=https://telestream-production.up.railway.app

# 5. Koi bhi random secret string (security ke liye)
#    Kuch bhi likh do — 20+ characters
WEBHOOK_SECRET=mera-secret-kuch-bhi-likh-do-yahan

# 6. Database path — EXACTLY yahi likhna, mat badalna
DB_PATH=/app/data/db.sqlite

# 7. PORT — Railway khud set karta hai, mat chhuo
PORT=3000
